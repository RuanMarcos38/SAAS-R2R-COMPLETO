generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
  records   AgencyRecord[]
  runs      AutomationRun[]
  events    AuditEvent[]
}
model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("COLLABORATOR")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  @@index([tenantId, role])
}
model AgencyRecord {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind        String
  title       String
  status      String   @default("NOVO")
  description String?  @db.Text
  valueCents  Int?
  clientId    String?
  assigneeId  String?
  dueAt       DateTime?
  data        Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([tenantId, kind, status])
  @@index([tenantId, clientId])
  @@index([tenantId, dueAt])
}
model AutomationRun {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowId String
  status     String
  result     Json     @default("{}")
  createdAt  DateTime @default(now())
  @@index([tenantId, workflowId, createdAt])
}
model AuditEvent {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId   String?
  action    String
  kind      String
  targetId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  @@index([tenantId, createdAt])
}

model DirectorThread {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  title      String   @default("Nova conversa")
  messages   DirectorMessage[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([tenantId, userId, updatedAt])
}
model DirectorMessage {
  id         String   @id @default(cuid())
  threadId   String
  thread     DirectorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role       String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  @@index([threadId, createdAt])
}
model AgentJob {
  id               String    @id @default(cuid())
  tenantId         String
  threadId         String
  requesterId      String
  department       String
  title            String
  instructions     String    @db.Text
  status           String    @default("QUEUED")
  requiresApproval Boolean   @default(false)
  approvedBy       String?
  output           String?   @db.Text
  error            String?   @db.Text
  attempts         Int       @default(0)
  createdAt        DateTime  @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  @@index([tenantId, status, createdAt])
  @@index([tenantId, threadId])
}
